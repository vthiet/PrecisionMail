<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nlu.fit.soft.gr5.precisionMail.controller.MainController">

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <!-- INPUT AREA -->
            <GridPane hgap="10" vgap="10" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <TextField fx:id="toField"
                           promptText="Người nhận"
                           styleClass="underline-field"
                           GridPane.hgrow="ALWAYS"/>

                <TextField fx:id="subjectField"
                           promptText="Tiêu đề"
                           styleClass="underline-field"
                           GridPane.rowIndex="1"
                           GridPane.hgrow="ALWAYS"/>
            </GridPane>

            <!-- CONTENT -->
            <TextArea fx:id="contentArea"
                      VBox.vgrow="ALWAYS"
                      styleClass="noline-field"
                      wrapText="true"/>

            <!-- ACTION BAR -->
            <HBox spacing="10" alignment="CENTER_LEFT">

                <!-- LEFT GROUP -->
                <HBox spacing="8" HBox.hgrow="ALWAYS">
                    <Button fx:id="sendBtn"
                            text="Gửi"
                            styleClass="send-btn"
                            onAction="#handleSendBtn"
                    />
                    <Button text="Gửi theo lịch biểu"/>
                    <Button text="Đính kèm tệp"/>
                </HBox>

                <!-- RIGHT -->
                <Button text="Bỏ thư nháp"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>