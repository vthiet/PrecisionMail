<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<DialogPane xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nlu.fit.soft.gr5.precisionMail.controller.dialog.PreviewEmailController"
            stylesheets="@../../css/app.css"
            prefWidth="700" prefHeight="600">

    <headerText>Email Preview - Review Before Sending</headerText>

    <content>
        <VBox spacing="15" styleClass="preview-content">

            <!-- From Section -->
            <HBox spacing="10" styleClass="preview-section">
                <Label text="From:" styleClass="preview-label" prefWidth="80"/>
                <Label fx:id="fromLabel" text="sender@example.com"
                       styleClass="preview-value" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- To Section -->
            <VBox spacing="5" styleClass="preview-section">
                <HBox spacing="10">
                    <Label text="To:" styleClass="preview-label" prefWidth="80"/>
                    <Label fx:id="toLabel" text="recipient@example.com"
                           styleClass="preview-value" HBox.hgrow="ALWAYS" wrapText="true"/>
                </HBox>
            </VBox>

            <!-- CC Section (if present) -->
            <VBox fx:id="ccSection" spacing="5" styleClass="preview-section">
                <HBox spacing="10">
                    <Label text="Cc:" styleClass="preview-label" prefWidth="80"/>
                    <Label fx:id="ccLabel" text="" styleClass="preview-value" HBox.hgrow="ALWAYS" wrapText="true"/>
                </HBox>
            </VBox>

            <!-- BCC Section (if present) -->
            <VBox fx:id="bccSection" spacing="5" styleClass="preview-section">
                <HBox spacing="10">
                    <Label text="Bcc:" styleClass="preview-label" prefWidth="80"/>
                    <Label fx:id="bccLabel" text="" styleClass="preview-value" HBox.hgrow="ALWAYS" wrapText="true"/>
                </HBox>
            </VBox>

            <!-- Subject Section -->
            <HBox spacing="10" styleClass="preview-section">
                <Label text="Subject:" styleClass="preview-label" prefWidth="80"/>
                <Label fx:id="subjectLabel" text="[No Subject]"
                       styleClass="preview-value" HBox.hgrow="ALWAYS" wrapText="true"/>
            </HBox>

            <!-- Content Preview (HTML) -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Message Preview:" styleClass="preview-label"/>
                <WebView fx:id="contentWebView" prefHeight="250" styleClass="preview-bordered"/>
            </VBox>

            <!-- Attachments Section -->
            <VBox fx:id="attachmentSection" spacing="5">
                <Label text="Attachments:" styleClass="preview-label"/>
                <ListView fx:id="attachmentListView" prefHeight="100" styleClass="preview-bordered"/>
                <Label fx:id="attachmentInfoLabel" text="0 Attachments"
                       styleClass="helper-text"/>
            </VBox>

        </VBox>
    </content>

    <buttons>
        <Button text="Send" fx:id="sendButton" styleClass="dialog-action,primary-action"/>
        <Button text="Cancel" fx:id="cancelButton" styleClass="dialog-action"/>
    </buttons>

</DialogPane>
