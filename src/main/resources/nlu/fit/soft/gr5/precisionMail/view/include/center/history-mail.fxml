<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>

<SplitPane dividerPositions="0.35"
           prefHeight="600"
           prefWidth="1000"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="nlu.fit.soft.gr5.precisionMail.controller.fxml.HistoryMailController">
    <VBox spacing="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Sent Emails"
               style="-fx-font-size: 18px;
                      -fx-font-weight: bold;"/>

        <ListView fx:id="emailListView"
                  VBox.vgrow="ALWAYS"/>
    </VBox>

    <VBox spacing="12">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label fx:id="subjectLabel"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;"/>

        <Label fx:id="fromLabel"/>

        <Label fx:id="toLabel"/>

        <Label fx:id="dateLabel"/>

        <TextArea fx:id="contentArea"
                  editable="false"
                  wrapText="true"
                  VBox.vgrow="ALWAYS"/>
    </VBox>
</SplitPane>
