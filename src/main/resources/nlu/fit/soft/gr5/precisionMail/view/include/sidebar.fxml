<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>

<VBox styleClass="compose-left-sidebar" prefWidth="200" minWidth="180"
      style="-fx-background-color: #F6F8FC; -fx-border-color: transparent #DADCE0 transparent transparent; -fx-border-width: 0 1 0 0;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="16" right="0" bottom="16" left="12"/>
    </padding>

    <Button text="＋  Soạn thư mới" maxWidth="Infinity"
            style="-fx-background-color: #C2E7FF; -fx-text-fill: #001D35; -fx-font-weight: bold;
                           -fx-font-size: 13px; -fx-padding: 12 20 12 16; -fx-background-radius: 18;
                           -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 4, 0, 0, 2);">
        <VBox.margin>
            <Insets bottom="16" right="12"/>
        </VBox.margin>
    </Button>

    <Separator>
        <VBox.margin>
            <Insets bottom="10" right="12"/>
        </VBox.margin>
    </Separator>

    <Label text="HỘP THƯ"
           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #80868B; -fx-padding: 0 0 4 6;">
        <VBox.margin>
            <Insets bottom="2"/>
        </VBox.margin>
    </Label>

    <Button fx:id="btnInbox" text="📥  Hộp thư đến" maxWidth="Infinity"
            styleClass="sidebar-nav-item"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #202124; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Button fx:id="btnStarred" text="⭐  Quan trọng" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #202124; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Button fx:id="btnDrafts" text="📝  Thư nháp" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: #C2E7FF; -fx-text-fill: #001D35; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand;
                           -fx-font-size: 13px; -fx-font-weight: bold;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Button fx:id="btnSent" text="📤  Đã gửi" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #202124; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Separator>
        <VBox.margin>
            <Insets top="8" bottom="8" right="12"/>
        </VBox.margin>
    </Separator>

    <Label text="KHÁC"
           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #80868B; -fx-padding: 0 0 4 6;">
        <VBox.margin>
            <Insets bottom="2"/>
        </VBox.margin>
    </Label>

    <Button fx:id="btnSpam" text="⚠️  Thư rác" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #202124; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Button fx:id="btnTrash" text="🗑️  Thùng rác" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #202124; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Pane VBox.vgrow="ALWAYS"/>

    <Separator>
        <VBox.margin>
            <Insets bottom="8" right="12"/>
        </VBox.margin>
    </Separator>

    <Button fx:id="btnSettings" text="⚙️  Cài đặt" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #5F6368; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

    <Button fx:id="btnShortcuts" text="⌨️  Phím tắt" maxWidth="Infinity"
            disable="true"
            style="-fx-background-color: transparent; -fx-text-fill: #5F6368; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 9 16 9 14; -fx-background-radius: 0 24 24 0; -fx-cursor: hand; -fx-font-size: 13px;">
        <VBox.margin>
            <Insets right="0"/>
        </VBox.margin>
    </Button>

</VBox>