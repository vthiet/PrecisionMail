<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox styleClass="compose-left-sidebar"
      prefWidth="200"
      minWidth="180"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../../css/sidebar.css"
      fx:controller="nlu.fit.soft.gr5.precisionMail.controller.fxml.SideBarController">

    <padding>
        <Insets top="16" bottom="16" left="12"/>
    </padding>

    <Button fx:id="composeButton"
            onAction="#onNewMailClick"
            text="Soạn thư mới"
            maxWidth="Infinity"
            graphicTextGap="10"
            styleClass="compose-button">
        <graphic>
            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../../icons/add.png"/>
            </ImageView>
        </graphic>

        <VBox.margin>
            <Insets bottom="16" right="12"/>
        </VBox.margin>
    </Button>

    <Separator>
        <VBox.margin>
            <Insets bottom="10" right="12"/>
        </VBox.margin>
    </Separator>

    <Label text="HỘP THƯ"
           styleClass="sidebar-section-title">
        <VBox.margin>
            <Insets bottom="2"/>
        </VBox.margin>
    </Label>

    <Button fx:id="btnDrafts"
            text="📝  Thư nháp"
            maxWidth="Infinity"
            styleClass="sidebar-nav-item"/>

    <Button fx:id="btnQueue"
            text="⏱  Hàng đợi chờ gửi"
            maxWidth="Infinity"
            styleClass="sidebar-nav-item"
            onAction="#handleQueueBtn"/>

    <Button fx:id="btnSent"
            text="📤  Đã gửi"
            maxWidth="Infinity"
            styleClass="sidebar-nav-item"
            onAction="#handleSentMailBtn"/>

    <Button fx:id="btnLogs"
            text="📋  Log hệ thống"
            maxWidth="Infinity"
            styleClass="sidebar-nav-item"
            onAction="#handleLogsBtn"/>

    <Separator>
        <VBox.margin>
            <Insets top="8" bottom="8" right="12"/>
        </VBox.margin>
    </Separator>

    <Label text="KHÁC"
           styleClass="sidebar-section-title">
        <VBox.margin>
            <Insets bottom="2"/>
        </VBox.margin>
    </Label>

    <Button fx:id="btnSpam"
            text="⚠️  Thư rác"
            maxWidth="Infinity"
            styleClass="sidebar-nav-item"/>

    <Button fx:id="btnTrash"
            text="🗑️  Thùng rác"
            maxWidth="Infinity"
            styleClass="sidebar-nav-item"/>

    <Pane VBox.vgrow="ALWAYS"/>

    <Separator>
        <VBox.margin>
            <Insets bottom="8" right="12"/>
        </VBox.margin>
    </Separator>

    <Button fx:id="btnSettings"
            text="⚙️  Tài khoản"
            maxWidth="Infinity"
            onAction="#handleSettings"
            styleClass="sidebar-footer-item"/>
</VBox>
