<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import atlantafx.base.controls.ToggleSwitch?>

<VBox prefWidth="224"
      minWidth="224"
      maxWidth="224"
      styleClass="sidebar,bg-subtle,border-default"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nlu.fit.soft.gr5.precisionMail.controller.fxml.SideBarController">

    <padding>
        <Insets top="20" right="14" bottom="16" left="14"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-brand">
        <StackPane minWidth="34" prefWidth="34" minHeight="34" prefHeight="34" styleClass="sidebar-brand-mark">
            <SVGPath content="M2 4h20v16H2V4zm2 2v1.2l8 5.3 8-5.3V6l-8 5.3L4 6zm16 12V9.6l-8 5.3-8-5.3V18h16z"
                     styleClass="sidebar-brand-icon"/>
        </StackPane>
        <VBox spacing="0">
            <Label text="PrecisionMail" styleClass="sidebar-brand-title"/>
            <Label text="Quản lý email" styleClass="sidebar-brand-subtitle,text-muted"/>
        </VBox>
    </HBox>

    <Button fx:id="composeButton"
            onAction="#onNewMailClick"
            text="Soạn thư mới"
            maxWidth="Infinity"
            graphicTextGap="11"
            styleClass="compose-button,accent">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7V4z" styleClass="compose-button-icon"/>
            </StackPane>
        </graphic>
        <VBox.margin>
            <Insets top="22" bottom="22"/>
        </VBox.margin>
    </Button>

    <Label text="HỘP THƯ" styleClass="sidebar-section-title,text-muted"/>

    <Button fx:id="btnDrafts" text="Thư nháp" maxWidth="Infinity" graphicTextGap="12" styleClass="sidebar-nav-item,flat">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M4 3h13l3 3v15H4V3zm2 2v14h12V7h-2V5H6zm2 5h8v2H8v-2zm0 4h8v2H8v-2z"
                         styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Button fx:id="btnQueue" text="Hàng đợi" maxWidth="Infinity" graphicTextGap="12"
            styleClass="sidebar-nav-item,flat" onAction="#handleQueueBtn">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm1-13h-2v6l5 3 1-1.7-4-2.3V7z"
                         styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Button fx:id="btnSent" text="Đã gửi" maxWidth="Infinity" graphicTextGap="12"
            styleClass="sidebar-nav-item,flat" onAction="#handleSentMailBtn">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M2 3l20 9-20 9 3-8 10-1-10-1-3-8z" styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Button fx:id="btnStats" text="Thống kê" maxWidth="Infinity" graphicTextGap="12"
            styleClass="sidebar-nav-item,flat" onAction="#handleStatsBtn">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M4 20V10h4v10H4zm6 0V4h4v16h-4zm6 0v-7h4v7h-4z" styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Button fx:id="btnLogs" text="Log hệ thống" maxWidth="Infinity" graphicTextGap="12"
            styleClass="sidebar-nav-item,flat" onAction="#handleLogsBtn">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M5 3h14v18H5V3zm2 2v14h10V5H7zm2 3h6v2H9V8zm0 4h6v2H9v-2zm0 4h4v2H9v-2z"
                         styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Region minHeight="18"/>
    <Label text="QUẢN LÝ" styleClass="sidebar-section-title,text-muted"/>

    <Button fx:id="btnSpam" text="Thư rác" maxWidth="Infinity" graphicTextGap="12" styleClass="sidebar-nav-item,flat">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M7 2h10l5 5v10l-5 5H7l-5-5V7l5-5zm1 2L4 8v8l4 4h8l4-4V8l-4-4H8zm3 3h2v7h-2V7zm0 9h2v2h-2v-2z"
                         styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Button fx:id="btnTrash" text="Thùng rác" maxWidth="Infinity" graphicTextGap="12" styleClass="sidebar-nav-item,flat">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M7 4h3V2h4v2h3v2H7V4zm1 4h8l-1 13H9L8 8zm2 2 .6 9h2.8l.6-9h-4z"
                         styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>

    <Pane VBox.vgrow="ALWAYS"/>

    <ToggleSwitch fx:id="themeToggle" text="Chế độ tối" maxWidth="Infinity" styleClass="sidebar-theme-toggle"/>

    <Button fx:id="btnSettings" text="Tài khoản" maxWidth="Infinity" graphicTextGap="12"
            onAction="#handleSettings" styleClass="sidebar-footer-item,flat">
        <graphic>
            <StackPane styleClass="sidebar-icon-slot">
                <SVGPath content="M12 2a5 5 0 1 1-5 5 5 5 0 0 1 5-5zm0 2a3 3 0 1 0 3 3 3 3 0 0 0-3-3zm0 9c5 0 9 2.5 9 6v2H3v-2c0-3.5 4-6 9-6zm0 2c-4 0-7 1.8-7 4h14c0-2.2-3-4-7-4z"
                         styleClass="sidebar-nav-icon"/>
            </StackPane>
        </graphic>
    </Button>
</VBox>
